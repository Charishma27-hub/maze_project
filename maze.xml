<mujoco model="a1_maze">

    <compiler angle="radian" coordinate="local"/>

    <option gravity="0 0 -9.81" timestep="0.002"/>

    <visual>
        <headlight diffuse="0.8 0.8 0.8"
                   ambient="0.3 0.3 0.3"/>
    </visual>

    <asset>

        <texture name="floor_texture"
                 type="2d"
                 builtin="checker"
                 width="512"
                 height="512"
                 rgb1="0.75 0.75 0.75"
                 rgb2="0.55 0.55 0.55"/>

        <material name="floor_material"
                  texture="floor_texture"
                  texrepeat="5 5"/>

        <material name="wall_material"
                  rgba="0.2 0.2 0.2 1"/>

        <material name="start_material"
                  rgba="0 0.8 0 1"/>

        <material name="goal_material"
                  rgba="0.8 0.8 0 1"/>

    </asset>

    <worldbody>

        <!-- Virtual navigator used to test waypoint following -->
       <body name="navigator" mocap="true" pos="0 4 0.30">

         <geom name="navigator_geom"
          type="sphere"
          size="0.25"
          rgba="0 0 1 1"
          contype="0"
          conaffinity="0"/>

        </body>
        <!-- Floor -->
        <geom name="floor"
              type="box"
              size="4.5 2.5 0.05"
              pos="4.0 2.0 -0.05"
              material="floor_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_0"
              type="box"
              size="0.5 0.5 0.25"
              pos="4.0 4.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_1"
              type="box"
              size="0.5 0.5 0.25"
              pos="0.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_2"
              type="box"
              size="0.5 0.5 0.25"
              pos="1.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_3"
              type="box"
              size="0.5 0.5 0.25"
              pos="2.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_4"
              type="box"
              size="0.5 0.5 0.25"
              pos="4.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_5"
              type="box"
              size="0.5 0.5 0.25"
              pos="6.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_6"
              type="box"
              size="0.5 0.5 0.25"
              pos="7.0 3.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_7"
              type="box"
              size="0.5 0.5 0.25"
              pos="1.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_8"
              type="box"
              size="0.5 0.5 0.25"
              pos="2.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_9"
              type="box"
              size="0.5 0.5 0.25"
              pos="3.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_10"
              type="box"
              size="0.5 0.5 0.25"
              pos="4.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_11"
              type="box"
              size="0.5 0.5 0.25"
              pos="5.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_12"
              type="box"
              size="0.5 0.5 0.25"
              pos="6.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <geom name="wall_13"
              type="box"
              size="0.5 0.5 0.25"
              pos="7.0 1.0 0.25"
              material="wall_material"
              contype="1"
              conaffinity="1"/>

        <!-- Start marker -->
        <geom name="start_marker"
              type="cylinder"
              size="0.25 0.01"
              pos="0.0 4.0 0.01"
              material="start_material"
              contype="0"
              conaffinity="0"/>

        <!-- Goal marker -->
        <geom name="goal_marker"
              type="cylinder"
              size="0.25 0.01"
              pos="8.0 0.0 0.01"
              material="goal_material"
              contype="0"
              conaffinity="0"/>

    </worldbody>

</mujoco>
